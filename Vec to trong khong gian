<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thử Thách Toán 12 - Tích Vô Hướng Oxyz</title>
    
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script>
        window.MathJax = { tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] } };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800&display=swap');

        :root {
            --primary: #0284C7;
            --primary-dark: #0369A1;
            --success: #16A34A;
            --danger: #DC2626;
            --bg-color: #F0F9FF;
            --card-bg: #FFFFFF;
            --text-main: #0F172A;
            --text-gray: #475569;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Be Vietnam Pro', sans-serif; }

        body {
            background-color: var(--bg-color);
            background-image: radial-gradient(#bae6fd 1px, transparent 1px);
            background-size: 20px 20px;
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; padding: 15px; color: var(--text-main);
        }

        .app-container {
            background: var(--card-bg); width: 100%; max-width: 480px;
            border-radius: 20px; box-shadow: 0 10px 25px rgba(2, 132, 199, 0.1);
            overflow: hidden; position: relative;
        }

        .screen { display: none; padding: 30px 25px; animation: fadeIn 0.4s ease; }
        .screen.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .title { text-align: center; color: var(--primary); font-size: 1.4rem; font-weight: 800; margin-bottom: 5px; text-transform: uppercase; }
        .subtitle { text-align: center; color: var(--text-gray); font-weight: 600; margin-bottom: 25px; font-size: 0.95rem; }

        .input-group { margin-bottom: 15px; }
        .input-group label { display: block; margin-bottom: 8px; font-weight: 700; font-size: 0.9rem; color: var(--primary-dark);}
        .input-group input { width: 100%; padding: 14px; border: 2px solid #E2E8F0; border-radius: 12px; font-size: 1rem; outline: none; background: #F8FAFC;}
        .input-group input:focus { border-color: var(--primary); background: #fff;}

        .btn {
            width: 100%; padding: 15px; border: none; border-radius: 12px;
            font-size: 1.05rem; font-weight: 700; cursor: pointer; transition: 0.2s; margin-top: 10px;
        }
        .btn-primary { background: var(--primary); color: white; }
        .btn-primary:hover { background: var(--primary-dark); transform: translateY(-2px); }
        .btn-success { background: var(--success); color: white; }
        .btn-danger { background: var(--danger); color: white; }
        .btn-outline { background: transparent; border: 2px solid var(--primary); color: var(--primary); }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none !important; }

        .header-quiz { display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 15px; color: var(--primary); }
        .progress-bar { background: #E2E8F0; border-radius: 10px; height: 8px; margin-bottom: 25px; overflow: hidden; }
        .progress-fill { background: var(--success); height: 100%; width: 0%; transition: width 0.3s; }
        
        .question-box { font-size: 1.15rem; font-weight: 600; line-height: 1.6; margin-bottom: 25px; min-height: 120px; }
        .tf-buttons { display: flex; gap: 15px; margin-bottom: 20px; }
        .tf-buttons .btn { margin-top: 0; }

        .feedback { display: none; padding: 15px; border-radius: 12px; margin-bottom: 20px; animation: fadeIn 0.3s; border: 2px solid transparent;}
        .feedback.correct { background: #DCFCE7; border-color: #22C55E; color: #166534;}
        .feedback.incorrect { background: #FEE2E2; border-color: #EF4444; color: #991B1B;}
        .feedback-title { font-weight: 800; margin-bottom: 5px; font-size: 1.05rem;}
        .feedback-desc { font-size: 0.95rem; line-height: 1.5; }

        .result-circle {
            width: 120px; height: 120px; border-radius: 50%; border: 8px solid var(--primary);
            display: flex; align-items: center; justify-content: center;
            font-size: 2rem; font-weight: 800; margin: 0 auto 20px; color: var(--primary);
        }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px; }
        .stat-card { background: #F8FAFC; padding: 15px; border-radius: 12px; text-align: center; font-weight: 600; border: 1px solid #E2E8F0;}
        .stat-card span { display: block; font-size: 1.5rem; font-weight: 800; margin-top: 5px;}
        .stat-correct { color: var(--success); }
        .stat-wrong { color: var(--danger); }
        
        .summary-string {
            background: #FEF08A; color: #854D0E; padding: 15px; border-radius: 12px;
            font-weight: 700; text-align: center; margin-bottom: 25px; font-size: 0.9rem;
            border: 2px dashed #EAB308; word-wrap: break-word; line-height: 1.5;
        }
    </style>
</head>
<body>

<div class="app-container" id="capture-area">
    <!-- MÀN HÌNH 1: GIỚI THIỆU -->
    <div id="screen-1" class="screen active">
        <div class="title">THỬ THÁCH TOÁN 12</div>
        <div class="subtitle">Chủ đề: Tích vô hướng của vectơ (Oxyz)</div>
        
        <div class="input-group">
            <label>Họ và tên:</label>
            <input type="text" id="student-name" placeholder="VD: Trần Văn B" required autocomplete="off">
        </div>
        <div class="input-group">
            <label>Lớp:</label>
            <input type="text" id="student-class" placeholder="VD: 12A2" required autocomplete="off">
        </div>

        <button class="btn btn-primary" onclick="startQuiz()">BẮT ĐẦU 🚀</button>
    </div>

    <!-- MÀN HÌNH 2: TRẮC NGHIỆM -->
    <div id="screen-2" class="screen">
        <div class="header-quiz">
            <span id="question-counter">Câu 1/10</span>
            <span id="score-tracker">Điểm: 0</span>
        </div>
        <div class="progress-bar"><div class="progress-fill" id="progress-bar"></div></div>

        <div class="question-box" id="question-text">Đang tải...</div>

        <div class="tf-buttons">
            <button class="btn btn-success" id="btn-true" onclick="checkAnswer(true)">ĐÚNG</button>
            <button class="btn btn-danger" id="btn-false" onclick="checkAnswer(false)">SAI</button>
        </div>

        <div class="feedback" id="feedback-box">
            <div class="feedback-title" id="feedback-title"></div>
            <div class="feedback-desc" id="feedback-desc"></div>
        </div>

        <button class="btn btn-primary" id="btn-next" style="display: none;" onclick="nextQuestion()">TIẾP TỤC ➔</button>
    </div>

    <!-- MÀN HÌNH 3: KẾT QUẢ -->
    <div id="screen-3" class="screen">
        <div class="title" id="rank-title">KẾT QUẢ</div>
        <div class="result-circle" id="final-score">0/10</div>
        
        <div class="stats-grid">
            <div class="stat-card">Tỉ lệ đúng<span class="stat-correct" id="final-percent">0%</span></div>
            <div class="stat-card">Câu sai<span class="stat-wrong" id="final-wrong">0</span></div>
        </div>

        <div class="summary-string" id="summary-string"></div>

        <button class="btn btn-primary" id="btn-capture" onclick="captureResult()">📸 LƯU ẢNH KẾT QUẢ</button>
        <button class="btn btn-outline" id="btn-retry" onclick="location.reload()">🔄 LÀM LẠI</button>
    </div>
</div>

<script>
    // MA TRẬN 10 CÂU HỎI (TOÁN 12 - TỌA ĐỘ OXYZ)
    const questions = [
        {
            text: "Trong không gian $Oxyz$, cho hai vectơ $\\vec{a}=(x_1; y_1; z_1)$ và $\\vec{b}=(x_2; y_2; z_2)$. Tích vô hướng của chúng được tính bằng công thức: $\\vec{a} \\cdot \\vec{b} = x_1x_2 + y_1y_2 + z_1z_2$.",
            isTrue: true,
            explanation: "Hoàn toàn chính xác. Đây là công thức tọa độ cơ bản của tích vô hướng trong không gian $Oxyz$."
        },
        {
            text: "Bình phương vô hướng của một vectơ luôn bằng bình phương độ dài của vectơ đó, tức là $\\vec{a}^2 = |\\vec{a}|^2$.",
            isTrue: true,
            explanation: "Chính xác. $\\vec{a}^2 = \\vec{a} \\cdot \\vec{a} = |\\vec{a}| \\cdot |\\vec{a}| \\cdot \\cos 0^{\\circ} = |\\vec{a}|^2$."
        },
        {
            text: "Hai vectơ $\\vec{a}$ và $\\vec{b}$ (khác $\\vec{0}$) vuông góc với nhau khi và chỉ khi $\\vec{a} \\cdot \\vec{b} = 1$.",
            isTrue: false,
            explanation: "Sai. Điều kiện vuông góc của hai vectơ là tích vô hướng của chúng phải bằng $0$ (vì $\\cos 90^{\\circ} = 0$), không phải bằng $1$."
        },
        {
            text: "Góc giữa hai vectơ $\\vec{a}$ và $\\vec{b}$ luôn luôn là một góc nhọn (từ $0^{\\circ}$ đến $90^{\\circ}$).",
            isTrue: false,
            explanation: "Sai. Góc giữa hai vectơ có thể nhận giá trị từ $0^{\\circ}$ đến $180^{\\circ}$. Nếu tích vô hướng âm, góc giữa chúng là góc tù."
        },
        {
            text: "Trong hệ trục toạ độ $Oxyz$, các vectơ đơn vị $\\vec{i}, \\vec{j}, \\vec{k}$ thỏa mãn: $\\vec{i} \\cdot \\vec{j} = \\vec{j} \\cdot \\vec{k} = \\vec{k} \\cdot \\vec{i} = 0$.",
            isTrue: true,
            explanation: "Chính xác. Các vectơ đơn vị trên 3 trục tọa độ đôi một vuông góc với nhau nên tích vô hướng của từng cặp đều bằng $0$."
        },
        {
            text: "Công thức tính côsin góc giữa hai vectơ $\\vec{a}, \\vec{b}$ khác $\\vec{0}$ là: $\\cos(\\vec{a}, \\vec{b}) = \\frac{\\vec{a} \\cdot \\vec{b}}{|\\vec{a}| + |\\vec{b}|}$.",
            isTrue: false,
            explanation: "Sai. Dưới mẫu số phải là TÍCH độ dài, không phải tổng độ dài: $\\cos(\\vec{a}, \\vec{b}) = \\frac{\\vec{a} \\cdot \\vec{b}}{|\\vec{a}| \\cdot |\\vec{b}|}$."
        },
        {
            text: "Cho $\\vec{u} = (1; -2; 3)$ và $\\vec{v} = (2; 1; 0)$. Ta có $\\vec{u} \\cdot \\vec{v} = 0$, suy ra $\\vec{u} \\bot \\vec{v}$.",
            isTrue: true,
            explanation: "Đúng. Ta tính $\\vec{u} \\cdot \\vec{v} = 1\\cdot 2 + (-2)\\cdot 1 + 3\\cdot 0 = 2 - 2 + 0 = 0$. Do đó hai vectơ vuông góc."
        },
        {
            text: "Nếu $\\vec{a} \\cdot \\vec{b} < 0$ thì góc giữa hai vectơ $\\vec{a}$ và $\\vec{b}$ là góc tù.",
            isTrue: true,
            explanation: "Chính xác. Góc tù (lớn hơn $90^{\\circ}$ và nhỏ hơn hoặc bằng $180^{\\circ}$) có giá trị côsin mang dấu âm, kéo theo tích vô hướng âm."
        },
        {
            text: "Cho 3 điểm $A(1;0;0), B(0;1;0), C(0;0;1)$. Tam giác $ABC$ là tam giác vuông tại $A$.",
            isTrue: false,
            explanation: "Sai. Ta có $\\vec{AB} = (-1;1;0)$ và $\\vec{AC} = (-1;0;1)$. $\\vec{AB} \\cdot \\vec{AC} = (-1)(-1) + 1\\cdot 0 + 0\\cdot 1 = 1 \\neq 0$. Tam giác này thực chất là tam giác đều."
        },
        {
            text: "Trong không gian $Oxyz$, độ dài của vectơ $\\vec{u} = (x; y; z)$ được tính bởi $|\\vec{u}| = \\sqrt{x^2 + y^2 + z^2}$.",
            isTrue: true,
            explanation: "Đúng. Đây là hệ quả trực tiếp từ công thức bình phương vô hướng: $\\vec{u}^2 = x^2 + y^2 + z^2$."
        }
    ];

    let currentQ = 0, score = 0, sName = "", sClass = "";

    function switchScreen(id) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(id).classList.add('active');
    }

    function startQuiz() {
        sName = document.getElementById('student-name').value.trim();
        sClass = document.getElementById('student-class').value.trim();
        if(!sName || !sClass) return alert("Vui lòng nhập đủ Họ tên và Lớp!");
        switchScreen('screen-2');
        loadQuestion();
    }

    function loadQuestion() {
        let q = questions[currentQ];
        document.getElementById('feedback-box').style.display = 'none';
        document.getElementById('btn-next').style.display = 'none';
        document.getElementById('btn-true').disabled = false;
        document.getElementById('btn-false').disabled = false;
        document.getElementById('question-counter').innerText = `Câu ${currentQ + 1}/10`;
        document.getElementById('progress-bar').style.width = `${(currentQ / 10) * 100}%`;
        
        let qEl = document.getElementById('question-text');
        qEl.innerHTML = q.text;
        if (window.MathJax) MathJax.typesetPromise([qEl]);
    }

    function checkAnswer(userChoice) {
        document.getElementById('btn-true').disabled = true;
        document.getElementById('btn-false').disabled = true;

        let q = questions[currentQ];
        let isCorrect = (userChoice === q.isTrue);
        if(isCorrect) score++;
        
        document.getElementById('score-tracker').innerText = `Điểm: ${score}`;
        let fbBox = document.getElementById('feedback-box');
        fbBox.style.display = 'block';
        fbBox.className = 'feedback ' + (isCorrect ? 'correct' : 'incorrect');
        
        document.getElementById('feedback-title').innerText = isCorrect ? "🎉 CHÍNH XÁC!" : "💡 CHƯA ĐÚNG!";
        let fbDesc = document.getElementById('feedback-desc');
        fbDesc.innerHTML = q.explanation;
        if (window.MathJax) MathJax.typesetPromise([fbDesc]);

        document.getElementById('btn-next').style.display = 'block';
    }

    function nextQuestion() {
        currentQ++;
        if(currentQ < 10) loadQuestion();
        else showSummary();
    }

    function showSummary() {
        switchScreen('screen-3');
        let rank = score >= 9 ? "XUẤT SẮC" : score >= 7 ? "RẤT TỐT" : score >= 5 ? "CẦN CỐ GẮNG" : "CẦN ÔN LẠI";
        let color = score >= 7 ? "var(--success)" : score >= 5 ? "#EAB308" : "var(--danger)";
        
        document.getElementById('rank-title').innerText = rank;
        document.getElementById('rank-title').style.color = color;
        
        let scCircle = document.getElementById('final-score');
        scCircle.innerText = `${score}/10`; scCircle.style.borderColor = color; scCircle.style.color = color;
        
        document.getElementById('final-percent').innerText = `${score*10}%`;
        document.getElementById('final-wrong').innerText = 10 - score;

        document.getElementById('summary-string').innerText = 
            `LỚP: ${sClass.toUpperCase()} | HỌ TÊN: ${sName.toUpperCase()} | TÍCH VÔ HƯỚNG OXYZ | ĐIỂM: ${score}/10`;
    }

    function captureResult() {
        let area = document.getElementById('capture-area');
        document.getElementById('btn-capture').style.display = 'none';
        document.getElementById('btn-retry').style.display = 'none';
        
        html2canvas(area, { backgroundColor: "#F0F9FF", scale: 2 }).then(canvas => {
            let link = document.createElement('a');
            link.download = `Toan12_Oxyz_${sName.replace(/\s+/g, '')}.png`;
            link.href = canvas.toDataURL("image/png");
            link.click();
            document.getElementById('btn-capture').style.display = 'block';
            document.getElementById('btn-retry').style.display = 'block';
        });
    }
</script>
</body>
</html>

```
